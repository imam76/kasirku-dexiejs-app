src-tauri/migrations/*.sql text eol=lf

# Repo convention is CRLF for hand-authored TS/TSX source under src/ and
# tests/ (the large majority of tracked files already use it). Pin it
# explicitly so edits from any OS/tool normalize to the same line ending
# instead of producing whole-file noise diffs. Scoped to src/ and tests/
# only so tool-managed files (package.json, tauri configs, lockfiles) keep
# whatever line ending the tool that writes them uses.
src/**/*.ts text eol=crlf
src/**/*.tsx text eol=crlf
tests/**/*.ts text eol=crlf
tests/**/*.tsx text eol=crlf

# Auto-generated by the router; regenerated by tooling, don't force EOL.
src/routeTree.gen.ts -text
