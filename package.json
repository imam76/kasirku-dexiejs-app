{
  "name": "frayukti",
  "private": true,
  "version": "1.0.81",
  "type": "module",
  "scripts": {
    "billing:dev": "bun --env-file=services/billing/.env --watch services/billing/server.ts",
    "billing:start": "node --experimental-strip-types --env-file=services/billing/.env services/billing/server.ts",
    "billing:check": "tsc -p services/billing/tsconfig.json",
    "billing:db": "docker compose -f services/billing/compose.yml up -d",
    "test:billing": "bun --env-file=services/billing/.env test tests/billing",
    "billing:smoke": "bun scripts/billing-sandbox-smoke.ts",
    "billing:reconcile": "bun --env-file=services/billing/.env scripts/billing-reconcile.ts",
    "billing:release-env:check": "node scripts/validate-billing-release-env.mjs",
    "billing:edge:check": "bunx deno check services/billing/supabase/functions/billing/index.ts services/billing/supabase/functions/billing-public/index.ts",
    "billing:edge:test": "bunx deno test --no-lock --config services/billing/supabase/functions/billing/deno.json tests/edge/midtrans.test.ts",
    "supabase:start": "bunx supabase --workdir services/billing start",
    "supabase:billing:serve": "bunx supabase --workdir services/billing functions serve",
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "lint": "eslint .",
    "test:unit": "bun test tests/unit",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean:dexie": "node scripts/clean-dexie-dev.mjs",
    "tauri:dev:fresh": "bun scripts/tauri-dev-fresh.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "clean": "rm -rf dist src-tauri/target/release/bundle",
    "clean:bundle": "rm -rf src-tauri/target/release/bundle",
    "clean:all": "rm -rf dist && cd src-tauri && cargo clean",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@saurl/tauri-plugin-safe-area-insets-css-api": "0.1.0",
    "@supabase/server": "^1.6.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.163.2",
    "@tanstack/react-router-devtools": "^1.163.2",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/jspdf": "^2.0.0",
    "@zxing/browser": "^0.1.5",
    "antd": "^6.3.1",
    "antd-mobile": "^5.42.3",
    "dayjs": "^1.11.13",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "fastify": "^5.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.344.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.3.3",
    "tauri-plugin-share": "^2.0.4",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@tanstack/router-plugin": "^1.163.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
